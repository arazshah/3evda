# Copy to .env for local use. In Coolify, set these under the resource's "Environment Variables".
# Never commit real values.

# --- Django ---------------------------------------------------------------
# Random string, at least 50 characters:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Old keys (comma separated) still accepted after a rotation, so existing links keep working.
DJANGO_SECRET_KEY_FALLBACKS=
# true = browser only reports CSP violations instead of blocking (emergency switch).
CSP_REPORT_ONLY=false
DJANGO_ALLOWED_HOSTS=3evda.com,www.3evda.com
PUBLIC_URL=https://3evda.com
LOG_LEVEL=INFO
GUNICORN_WORKERS=3
CELERY_CONCURRENCY=2

# --- Admin bootstrap (one-time) ---------------------------------------------------
# Used once by `python manage.py bootstrap_admin`; remove it from Coolify afterwards.
# ADMIN_BOOTSTRAP_USERNAME=sevda
# ADMIN_BOOTSTRAP_PASSWORD=

# --- Media ----------------------------------------------------------------
MEDIA_MAX_IMAGE_BYTES=52428800
MEDIA_MAX_VIDEO_BYTES=104857600

# --- Public enquiry form ------------------------------------------------------
# How many enquiries one visitor (IP address) may send, e.g. 5/hour or 20/day.
INQUIRY_RATE=5/hour

# --- Public booking form ------------------------------------------------------
# How many bookings one visitor (IP address) may make, e.g. 10/hour.
BOOKING_RATE=10/hour

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=threevda
POSTGRES_USER=threevda
POSTGRES_PASSWORD=

# --- Object storage (SeaweedFS S3) ------------------------------------------
# Choose long random values; they are also used to generate the storage credentials file.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PRIVATE_BUCKET=private
S3_PUBLIC_BUCKET=public

# --- Backup (nightly at 03:00 Tehran; the site is read-only for a few minutes) ---------------------------
# Encrypts the backup. Keep a copy OUTSIDE the server (a password manager): without it a backup cannot be opened,
# and the backup does NOT contain the secrets in this file.
RESTIC_PASSWORD=
# Where backups go. Default: the server's own `backups` volume. For a copy off the server use e.g.
# sftp:user@host:/path  or  s3:https://s3.example.com/bucket  (extra credentials as restic documents).
BACKUP_REPOSITORY=/backups/repo
BACKUP_HOUR=3

# --- Gateway ------------------------------------------------------------------
GATEWAY_MAX_BODY=110MB

# --- Build mirrors (only if the server cannot reach Docker Hub / PyPI / npm) ----
# BASE_REGISTRY=docker.io/library
# PIP_INDEX_URL=https://pypi.org/simple
# NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
# DEBIAN_MIRROR=https://deb.debian.org   (replaces deb.debian.org for apt in the api image)
# SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.48
